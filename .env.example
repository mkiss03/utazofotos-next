# =====================================================
# UtazóFotós – környezeti változók sablon
# =====================================================
# Másold át a fájlt ".env.local" néven és töltsd ki.
# A .env.local NINCS commitolva (.gitignore).

# --- Adatbázis (Vercel Postgres / Neon) -----------------
# A Vercel dashboard → Storage → Postgres létrehozása után
# a "Quickstart" fülön találod ezt a connection stringet.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth.js -------------------------------------------
# Generálj egy random titkos kulcsot:
#   PowerShell:  [Convert]::ToBase64String((1..32 | %{[byte](Get-Random -Max 256)}))
#   vagy:        npx auth secret
AUTH_SECRET="cseréld_le_egy_random_32+_karakteres_stringre"

# --- Vercel Blob (képfeltöltéshez, később) -------------
# Vercel dashboard → Storage → Blob létrehozása után jön.
BLOB_READ_WRITE_TOKEN=""

# --- Site URL (e-mail linkekhez, később) ---------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
